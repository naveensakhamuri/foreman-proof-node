{
  "version": 1,
  "project": {
    "name": "Foreman proof (Node)"
  },
  "checks": [
    {
      "run": "npm test",
      "when": "always"
    }
  ],
  "ship": {
    "steps": [
      "merge-main",
      "resources",
      "push",
      "pr",
      "ci",
      "merge"
    ],
    "ci": {
      "required": [
        "test"
      ]
    }
  },
  "slots": 2,
  "state": {
    "store": "branch"
  },
  "cloud": {
    "actions": {
      "cron": "17 6 * * *"
    }
  },
  "stories": {
    "adapter": "jira",
    "site": "finefactory.atlassian.net",
    "jql": "project = FP AND labels = foreman AND statusCategory != Done ORDER BY Rank",
    "transitions": {
      "started": "In Progress",
      "shipped": "Done"
    }
  }
}
